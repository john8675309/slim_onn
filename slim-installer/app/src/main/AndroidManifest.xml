<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The only install-related permission a sideloaded app can actually hold.
         INSTALL_PACKAGES and DELETE_PACKAGES are signature|privileged, so they
         are out of reach; those paths go through Shizuku instead. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Required before Shizuku.requestPermission() will do anything; without
         it the request is refused with no dialog. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Runs on TV boxes without a touchscreen, and on phones. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- Package visibility filtering (Android 11+) otherwise hides every
         package this app does not explicitly name, which would make the bloat
         list look entirely absent and the debloat silently do nothing. This is
         a sideloaded utility whose whole job is inspecting other packages. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PackageInstaller reports session results here. -->
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
